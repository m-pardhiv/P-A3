# --- Database -------------------------------------------------------------------------------
# PostgreSQL on this machine. Create the role and database first, as the README shows.
# A hosted Postgres (for example Supabase, via its Session pooler on port 5432) works too: it is
# reached over TLS automatically when the host is not localhost.
DATABASE_URL=postgresql://brightloop:CHOOSE_A_PASSWORD@127.0.0.1:5432/brightloop

# --- App ------------------------------------------------------------------------------------
# Public URL of the app. Used in email links. An https URL also makes the session cookie
# HTTPS-only (it is always HTTPS-only when NODE_ENV=production).
APP_URL=http://localhost:3000

# Port and address of `pnpm start` (production only).
PORT=3000
HOST=0.0.0.0

# Set to true ONLY behind a reverse proxy you control, so the login rate limit sees each visitor's
# real address from X-Forwarded-For. Leave false when the app faces the internet directly.
TRUST_PROXY=false

# --- Daily billing --------------------------------------------------------------------------
# on: the server bills by itself once a day, from BILLING_HOUR (India time) onwards.
# off: bill only from the Billing page. Handy for demos.
BILLING_SCHEDULER=on
BILLING_HOUR=2

# --- Email ----------------------------------------------------------------------------------
# Resend (https://resend.com): set the key and emails go out through its API. It wins over SMTP.
# MAIL_FROM must use a domain verified in Resend. To try it before verifying one, use
# MAIL_FROM=Brightloop <onboarding@resend.dev>, which only delivers to your own Resend account email.
RESEND_API_KEY=
#
# Or any SMTP server. Leave both empty in development to print emails to the server console.
# For local Mailpit (docker compose up -d): SMTP_HOST=localhost, SMTP_PORT=1025.
# With NODE_ENV=production one of RESEND_API_KEY or SMTP_HOST is required: emails fail without it.
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Brightloop <billing@brightloop.example>

# Show the demo accounts on the sign-in page. On by default in development, off in production.
# SHOW_DEMO_LOGINS=true

# --- Safety switches for the seed script (leave unset) --------------------------------------
# The demo data has a public password and `--reset` wipes every table, so both refuse to touch a
# database that is not on this machine, and never run with NODE_ENV=production.
# ALLOW_DEMO_SEED=true
# ALLOW_DB_RESET=true
