# Supabase: Project > Connect > Session pooler URI (port 5432).
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Public URL of the app, used in password reset links.
APP_URL=http://localhost:3000

# Leave SMTP_HOST empty in development to print emails to the server console.
# For local Mailpit (docker compose up -d): SMTP_HOST=localhost, SMTP_PORT=1025.
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Brightloop <billing@brightloop.example>
